# Porta exposta pelo Easypanel (ajuste se necessário)
PORT=3000

# RPC e rede
NETWORK=mainnet-beta
RPC_URL=https://seu-rpc-dedicado

# Whirlpool alvo
WHIRLPOOL_ADDRESS=HktfL7iwGKT5QHjywQkcDnZXScoh811k7akrMZJkCcEF
RANGE_WIDTH_PCT=1
RANGE_EXIT_BIAS_PCT=0.2
RANGE_ANCHOR=
PREFERRED_EXIT_TOKEN=tokenA
PREFERRED_EXIT_DIRECTION=down
SLIPPAGE_BPS=50
POLL_INTERVAL_MS=30000
RATE_LIMIT_COOLDOWN_SEC=30
HISTORY_MAX_EVENTS=500

# Kamino
KAMINO_REBALANCE_ENABLED=true
KAMINO_SCAN_INTERVAL_SEC=300

# Snapshots (serie temporal por pool, alimenta os graficos de evolucao)
SNAPSHOT_ENABLED=true
SNAPSHOT_INTERVAL_SEC=300
SNAPSHOT_MAX_POINTS=2880
SNAPSHOT_DOWNSAMPLE_ENABLED=true
SNAPSHOT_FLUSH_DEBOUNCE_MS=0
KAMINO_USE_WALLET_BALANCE_ON_REOPEN=true
AUTO_ADD_LIQUIDITY_ENABLED=false
AUTO_ADD_LIQUIDITY_CHECK_INTERVAL_SEC=300
AUTO_ADD_LIQUIDITY_POST_OPEN_BURST_SEC=60
AUTO_ADD_LIQUIDITY_MIN_USD=0
AUTO_SWAP_TO_SOL_DUAL_FINAL_CLEANUP_ENABLED=true
WALLET_BOOTSTRAP_MIN_USD=0
REBALANCE_SWAP_MIN_USD=0
KAMINO_BORROW_ASSET=usdc
KAMINO_REPAY_RETRY_SEC=15
KAMINO_REPAY_MAX_ATTEMPTS=3
KAMINO_GRACE_PERIOD_SEC=120

# Wallet (escolha UMA das duas opções)
# WALLET_PRIVATE_KEY=[1,2,3,...]          # array JSON OU base58
# WALLET_KEYPAIR_PATH=/path/para/id.json  # se o arquivo estiver montado no container

# UI básica (HTTP Basic Auth)
# UI_USER=admin
# UI_PASS=senha

# Opcional / integrações
# PYTH_SOL_USD_FEED_ID=

# Hermes (Pyth). O endpoint publico pode responder 401 sem chave.
PYTH_HERMES_URL=https://hermes.pyth.network
# PYTH_HERMES_API_KEY=
# Reaproveita o ultimo preco bom por N segundos se o Hermes falhar (0 = desligado)
PYTH_FALLBACK_MAX_AGE_SEC=0
# JUPITER_API_KEY=
# HEDGE_ENABLED=false
# REDIS_URL=redis://user:pass@host:6379

# Se preferir usar CONFIG_JSON em vez das variáveis acima, comente-as e defina:
# CONFIG_JSON={"network":"mainnet-beta","rpcUrl":"https://seu-rpc","whirlpoolAddress":"HktfL7iwGKT5QHjywQkcDnZXScoh811k7akrMZJkCcEF","rangeWidthPct":1,"rangeExitBiasPct":0.2,"preferredExitToken":"tokenA","preferredExitDirection":"down","slippageBps":50,"pollIntervalMs":30000,"historyMaxEvents":500,"kaminoRebalanceEnabled":true,"kaminoBorrowAsset":"usdc","kaminoRepayRetrySec":15,"kaminoRepayMaxAttempts":3,"kaminoGracePeriodSec":120,"autoAddLiquidityEnabled":false,"autoAddLiquidityCheckIntervalSec":300,"autoAddLiquidityPostOpenBurstSec":60,"autoAddLiquidityMinUsd":0,"dryRun":false}
